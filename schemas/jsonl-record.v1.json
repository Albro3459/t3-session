{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t3-session.dev/schemas/jsonl-record.v1.json",
  "title": "t3-session JSONL record",
  "type": "object",
  "required": ["schemaVersion", "recordType", "threadId", "data"],
  "properties": {
    "schemaVersion": { "const": "t3-session.jsonl-record.v1" },
    "recordType": {
      "type": "string",
      "enum": ["thread", "turn", "message", "activity"]
    },
    "threadId": { "type": ["string", "null"] },
    "data": { "type": "object" },
    "provider": { "type": "object" },
    "warnings": { "type": "array" }
  },
  "additionalProperties": false
}
